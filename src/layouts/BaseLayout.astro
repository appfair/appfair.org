---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DesignPicker from '../components/DesignPicker.astro';
import { site, design } from '../lib/site';
import { useTranslations, langOf, resolveLocale, stripLocale, localizePath, LOCALES, DEFAULT_LOCALE } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** Path of this page's OG image (default: the site card). */
  ogImage?: string;
  /** Index this page in site search (default: only default-locale pages, so fallback copies don't duplicate results). */
  searchable?: boolean;
}
const locale = resolveLocale(Astro.currentLocale);
const { t } = useTranslations(locale);
const { title, description = t('site.description'), active, ogImage, searchable = locale === DEFAULT_LOCALE } = Astro.props;
const fullTitle = title ? `${title} — ${t('site.short')}` : `${t('site.name')}: ${t('site.tagline')}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL(ogImage ?? '/assets/social-header.png', site.url).href;
const base = stripLocale(Astro.url.pathname);
// The chosen design lives in src/lib/site.ts. The picker (and the localStorage / ?style= override it
// relies on) only exists in development builds; a deployed page always renders exactly the default.
const showPicker = import.meta.env.DEV;
---
<!doctype html>
<html lang={langOf(locale)} data-style={design.style} data-layout={design.layout} data-visual={design.visual}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Apply the stored theme and the (temporary) design choice before first paint, so there is no flash.
        Mirrors ThemeToggle's and DesignPicker's resolve logic. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const p = localStorage.getItem('appfair-theme') || 'system';
          root.dataset.theme = (p === 'dark' || (p === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)) ? 'dark' : 'light';
        } catch (e) { root.dataset.theme = 'dark'; }
      })();
    </script>
    {showPicker && (
      <script is:inline>
        // Development only: the design picker's stored / URL-selected style and layout, applied before paint.
        (() => {
          const root = document.documentElement;
          try {
            const q = new URLSearchParams(location.search);
            const styles = ['midnight', 'fairground', 'editorial', 'civic'], layouts = ['split', 'classic', 'bold'], visuals = ['catalog', 'stacked', 'duo', 'emblem'];
            let d = {};
            try { d = JSON.parse(localStorage.getItem('appfair-design') || '{}') || {}; } catch (e) {}
            const s = styles.includes(q.get('style')) ? q.get('style') : (styles.includes(d.style) ? d.style : root.dataset.style);
            const l = layouts.includes(q.get('layout')) ? q.get('layout') : (layouts.includes(d.layout) ? d.layout : root.dataset.layout);
            const v = visuals.includes(q.get('visual')) ? q.get('visual') : (visuals.includes(d.visual) ? d.visual : root.dataset.visual);
            root.dataset.style = s; root.dataset.layout = l; root.dataset.visual = v;
            if (q.has('style') || q.has('layout') || q.has('visual')) localStorage.setItem('appfair-design', JSON.stringify({ style: s, layout: l, visual: v }));
            const t = q.get('theme');
            if (t && ['light', 'system', 'dark'].includes(t)) {
              localStorage.setItem('appfair-theme', t);
              root.dataset.theme = (t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)) ? 'dark' : 'light';
            }
          } catch (e) {}
        })();
      </script>
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/appfair-icon.svg" />
    <link rel="icon" type="image/png" href="/appfair-icon.png" />
    <link rel="apple-touch-icon" href="/appfair-icon.png" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.lang} href={new URL(localizePath(base, l.code), site.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, site.url).href} />
    <link rel="alternate" type="application/rss+xml" title={`${t('site.short')} ${t('blog.title')}`} href={site.rss} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    {/* JSON-LD Organization schema, declaring every social profile we control as canonically ours. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'The App Fair Project',
      url: site.url,
      logo: `${site.url}/assets/icons/appfair-icon.svg`,
      email: site.email,
      sameAs: site.social.filter((s) => s.me).map((s) => s.href),
    })} />
    {site.social.filter((s) => s.me).map((s) => <link rel="me" href={s.href} />)}
    <link rel="me" href={`mailto:${site.email}`} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Nav active={active} />
    {showPicker && <DesignPicker />}
    <main id="main" data-pagefind-body={searchable ? '' : undefined} data-pagefind-ignore={searchable ? undefined : ''}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
