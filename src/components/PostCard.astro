---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localizePath, formatDate } from '../i18n';
import { excerpt, readingTime } from '../lib/posts';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const locale = Astro.currentLocale;
const { t } = useTranslations(locale);
---
<a class="post-card" href={localizePath(`/blog/${post.id}/`, locale)}>
  <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time><span>·</span><span>{t('blog.readingTime', { n: readingTime(post.body ?? '') })}</span></div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description ?? excerpt(post.body ?? '')}</p>
  <span class="read-more">{t('blog.all') === 'All posts' ? 'Read more →' : '→'}</span>
</a>
