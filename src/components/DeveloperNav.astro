---
import { developerPages } from '../lib/developer-pages.mjs';
const { current } = Astro.props;

---
<nav class="developer-nav" aria-label="Developer documentation" data-pagefind-ignore>
  <a class="docs-home" href="/docs/">Developer guide</a>
  {developerPages.map(([href, title]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{title}</a>)}
  <a class="docs-source" href="https://github.com/appfair/appfair-apps/blob/main/CONTRIBUTING.md">Submission reference ↗</a>
</nav>
