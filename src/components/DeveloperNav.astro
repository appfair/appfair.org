---
import { developerPages } from '../lib/developer-pages.mjs';
import { useTranslations, localizePath } from '../i18n';
const { current } = Astro.props;
const { t, locale } = useTranslations(Astro.currentLocale);

---
<nav class="developer-nav" aria-label={t('docs.navigation')} data-pagefind-ignore>
  <a class="docs-home" href={localizePath('/docs/', locale)}>{t('docs.guide')}</a>
  {developerPages.map(([href, key]) => <a href={localizePath(href, locale)} aria-current={current === href ? 'page' : undefined}>{t(key)}</a>)}
  <a class="docs-source" href="https://github.com/appfair/appfair-apps/blob/main/CONTRIBUTING.md">{t('docs.reference')} ↗</a>
</nav>
