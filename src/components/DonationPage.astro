---
import Icon from './Icon.astro';
import { localizePath, useTranslations } from '../i18n';
const { t, locale } = useTranslations(Astro.currentLocale);
// Existing payment destinations; the page never handles payment or personal information.
const gifts = [
  { amount: '$5', href: 'https://donate.stripe.com/bIYcOD6R7c8lgWA3cj' },
  { amount: '$10', href: 'https://donate.stripe.com/9AQ15Va3j0pD8q4eV0' },
  { amount: '$20', href: 'https://donate.stripe.com/bIY8yna3j1tH35K5kk' },
  { amount: '$50', href: 'https://donate.stripe.com/8wM29ZgrHgoBgWAbIJ' },
  { amount: '$100', href: 'https://donate.stripe.com/8wMeWL0sJa0ddKo28a' },
  { href: 'https://donate.stripe.com/3cs3e34IZ3BPfSwaEJ' },
];
const impacts = [
  { icon: 'code', title: 'buildTitle', text: 'buildText' },
  { icon: 'heart', title: 'careTitle', text: 'careText' },
  { icon: 'globe', title: 'shareTitle', text: 'shareText' },
];
---
<div class="donation-page">
  <div class="container donation-inner">
    <section class="donation-hero" aria-labelledby="donation-title">
      <div class="donation-intro">
        <p class="donation-eyebrow"><span class="heart-mark"><Icon name="heart" size={19} /></span>{t('donation.eyebrow')}</p>
        <h1 id="donation-title"><span>{t('donation.titleFirst')}</span><span class="title-emphasis">{t('donation.titleSecond')}</span></h1>
        <p class="donation-lead">{t('donation.intro')}</p>
        <ul class="donation-promises">
          {['promiseFree', 'promisePrivate', 'promiseOpen'].map(key => <li><Icon name="check" size={16} />{t(`donation.${key}`)}</li>)}
        </ul>
      </div>
      <section class="giving-panel" aria-labelledby="giving-title">
        <div class="giving-heading">
          <h2 id="giving-title">{t('donation.panelTitle')}</h2>
          <p>{t('donation.panelIntro')}</p>
        </div>
        <div class="gift-grid">
          {gifts.map(gift => <a class:list={['gift-option', { 'gift-custom': !gift.amount }]} href={gift.href} aria-label={gift.amount ? t('donation.giveAmount', { amount: gift.amount }) : t('donation.customAmount')}>
            {gift.amount ?? t('donation.customAmount')}
          </a>)}
        </div>
        <p class="checkout-note"><Icon name="shield" size={15} />{t('donation.checkout')}</p>
        <div class="ongoing-support">
          <h3>{t('donation.ongoingTitle')}</h3>
          <p>{t('donation.ongoingText')}</p>
          <a class="patreon-link" href="https://www.patreon.com/appfair"><Icon name="heart" size={19} /><span>{t('donation.patreon')}</span><Icon name="arrow-right" size={19} /></a>
        </div>
      </section>
    </section>

    <section class="donation-impact" aria-labelledby="impact-title">
      <p class="donation-eyebrow">{t('donation.impactEyebrow')}</p>
      <h2 id="impact-title">{t('donation.impactTitle')}</h2>
      <div class="impact-grid">
        {impacts.map(impact => <div class="impact-item">
          <span class="impact-icon"><Icon name={impact.icon} size={23} /></span>
          <h3>{t(`donation.${impact.title}`)}</h3>
          <p>{t(`donation.${impact.text}`)}</p>
        </div>)}
      </div>
    </section>

    <section class="donation-trust" aria-labelledby="trust-title">
      <div class="trust-heading"><Icon name="shield" size={25} /><h2 id="trust-title">{t('donation.trustTitle')}</h2></div>
      <div class="trust-detail">
        <p>{t('donation.trustText')}</p>
        <p>{t('donation.receipt')}</p>
        <div class="trust-meta"><span>{t('donation.taxId', { id: '88-1461874' })}</span><a href={localizePath('/imprint/', locale)}>{t('donation.learnMore')}<Icon name="arrow-right" size={15} /></a></div>
      </div>
    </section>
    <p class="donation-thanks"><Icon name="heart" size={16} />{t('donation.thanks')}</p>
  </div>
</div>

<style>
  .donation-page { position: relative; isolation: isolate; overflow: hidden; background: radial-gradient(ellipse at 80% 12%, color-mix(in srgb, var(--brand) 8%, transparent), transparent 48%); }
  .donation-inner { padding-block: 76px 40px; }
  .donation-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; padding-bottom: 80px; }
  .donation-hero > * { min-width: 0; }
  .donation-eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 26px; font-size: .69rem; font-weight: 750; letter-spacing: .16em; line-height: 1.6; color: var(--brand-strong); }
  .heart-mark { display: grid; place-items: center; flex: 0 0 36px; height: 36px; border: 1px solid color-mix(in srgb, var(--brand) 22%, var(--border-soft)); border-radius: 50%; background: color-mix(in srgb, var(--brand) 6%, var(--surface)); }
  .donation-intro h1 { margin: 0 0 27px; font-size: clamp(3rem, 5.5vw, 4.5rem); font-weight: 780; letter-spacing: -.055em; line-height: 1.07; text-wrap: balance; }
  .donation-intro h1 span { display: block; }
  .title-emphasis { color: var(--brand-strong); font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 450; letter-spacing: -.045em; }
  .donation-lead { max-width: 40ch; margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.8; }
  .donation-promises { display: flex; flex-wrap: wrap; gap: 10px 18px; list-style: none; padding: 0; margin: 30px 0 0; }
  .donation-promises li { display: flex; align-items: center; gap: 7px; font-size: .76rem; font-weight: 600; color: var(--muted); }
  .donation-promises :global(svg) { color: var(--brand-strong); flex-shrink: 0; }
  .giving-panel { position: relative; padding: 34px; background: var(--surface); border: 1px solid color-mix(in srgb, var(--brand) 20%, var(--border-soft)); border-radius: 26px; box-shadow: 0 20px 65px -30px color-mix(in srgb, var(--brand) 30%, transparent), 0 4px 12px -8px rgba(0,0,0,.15); }
  .giving-panel::before { content: ''; position: absolute; top: -1px; left: 32px; right: 32px; height: 2px; background: linear-gradient(90deg, transparent, var(--brand), transparent); }
  .giving-heading h2 { font-size: 1.7rem; margin: 0 0 10px; letter-spacing: -.035em; }
  .giving-heading p { color: var(--muted); font-size: .91rem; margin: 0 0 24px; line-height: 1.65; }
  .gift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: minmax(72px, auto); gap: 10px; }
  .gift-option { display: flex; justify-content: center; align-items: center; padding: 12px 8px; border: 1px solid color-mix(in srgb, var(--brand) 23%, var(--border-soft)); border-radius: 12px; background: color-mix(in srgb, var(--brand) 5%, var(--surface)); color: var(--brand-strong); font-size: 1.55rem; font-weight: 700; font-variant-numeric: tabular-nums; text-align: center; line-height: 1.3; text-decoration: none; transition: background .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .gift-custom { font-size: .88rem; }
  .gift-option:hover { border-color: var(--brand); background: color-mix(in srgb, var(--brand) 13%, var(--surface)); color: var(--brand-strong); box-shadow: inset 0 0 0 1px var(--brand); }
  .gift-option:focus-visible, .patreon-link:focus-visible { outline: 3px solid var(--brand-strong); outline-offset: 4px; }
  .checkout-note { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 16px 0 24px; color: var(--muted); font-size: .72rem; line-height: 1.5; text-align: center; }
  .checkout-note :global(svg) { flex-shrink: 0; }
  .ongoing-support { padding-top: 23px; border-top: 1px solid var(--border-soft); }
  .ongoing-support h3 { font-size: .98rem; margin: 0 0 7px; letter-spacing: -.01em; }
  .ongoing-support p { margin: 0 0 17px; font-size: .83rem; color: var(--muted); line-height: 1.6; }
  .patreon-link { display: flex; align-items: center; justify-content: center; gap: 11px; min-height: 54px; padding: 14px 16px; border-radius: 12px; background: var(--brand-strong); color: var(--bg); font-size: .9rem; font-weight: 650; text-decoration: none; line-height: 1.4; text-align: center; transition: box-shadow .16s ease; }
  .patreon-link :global(svg) { flex-shrink: 0; }
  .patreon-link :global(svg:last-child) { margin-left: auto; }
  .patreon-link span { flex: 1; }
  .patreon-link:hover { color: var(--bg); box-shadow: 0 6px 20px -8px var(--brand); }
  .donation-impact { padding: 48px 0 46px; border-top: 1px solid var(--border-soft); }
  .donation-impact > .donation-eyebrow { margin-bottom: 12px; }
  .donation-impact > h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 34px; letter-spacing: -.035em; text-wrap: balance; }
  .impact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 38px; }
  .impact-icon { display: inline-flex; color: var(--brand-strong); margin-bottom: 16px; }
  .impact-item h3 { font-size: 1.02rem; letter-spacing: -.015em; margin: 0 0 10px; }
  .impact-item p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.75; max-width: 35ch; }
  .donation-trust { display: grid; grid-template-columns: 1fr 1.65fr; gap: 35px; border: 1px solid var(--border-soft); border-radius: 18px; padding: 28px 30px; background: color-mix(in srgb, var(--brand) 3%, var(--surface)); }
  .trust-heading { display: flex; align-items: flex-start; gap: 12px; }
  .trust-heading :global(svg) { flex-shrink: 0; color: var(--brand-strong); }
  .trust-heading h2 { font-size: 1rem; line-height: 1.5; margin: 0; }
  .trust-detail p { margin: 0 0 8px; color: var(--muted); font-size: .8rem; line-height: 1.75; }
  .trust-meta { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 15px; font-size: .75rem; color: var(--muted); }
  .trust-meta a { display: inline-flex; align-items: center; gap: 6px; color: var(--brand-strong); text-decoration: underline; text-underline-offset: 3px; }
  .donation-thanks { display: flex; justify-content: center; align-items: center; gap: 9px; margin: 30px 0 0; color: var(--muted); font-size: .77rem; text-align: center; }
  .donation-thanks :global(svg) { color: var(--brand-strong); flex-shrink: 0; }
  @media (max-width: 850px) {
    .donation-inner { padding-block: 46px 30px; }
    .donation-hero { grid-template-columns: 1fr; gap: 35px; max-width: 560px; margin-inline: auto; padding-bottom: 48px; }
    .donation-intro h1 { font-size: clamp(2.8rem, 8vw, 4.2rem); }
    .donation-lead { max-width: none; }
    .donation-promises { margin-top: 20px; }
    .impact-grid { gap: 22px; }
    .donation-trust { grid-template-columns: 1fr; gap: 15px; }
  }
  @media (max-width: 540px) {
    .donation-inner { padding-inline: 20px; padding-top: 32px; }
    .donation-eyebrow { margin-bottom: 20px; }
    .donation-intro h1 { margin-bottom: 18px; }
    .donation-lead { font-size: .96rem; line-height: 1.7; }
    .donation-promises { gap: 8px 14px; }
    .donation-promises li { font-size: .7rem; }
    .giving-panel { padding: 25px 20px; border-radius: 21px; }
    .giving-heading h2 { font-size: 1.5rem; }
    .gift-grid { gap: 8px; grid-auto-rows: minmax(68px, auto); }
    .gift-option { font-size: 1.4rem; }
    .gift-custom { font-size: .8rem; }
    .impact-grid { grid-template-columns: 1fr; gap: 26px; }
    .impact-item { display: grid; grid-template-columns: 30px 1fr; column-gap: 14px; }
    .impact-icon { grid-row: span 2; margin: 2px 0 0; }
    .impact-item h3 { margin-bottom: 7px; }
    .impact-item p { max-width: none; }
    .donation-impact { padding-block: 34px; }
    .donation-trust { padding: 23px 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .gift-option, .patreon-link { transition: none; } }
</style>
