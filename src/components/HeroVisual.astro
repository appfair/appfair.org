---
// The hero graphic: a theme-adaptive mock-up drawn in CSS, so it needs no screenshot and follows the
// palette. Four tags name the promises the headline makes (Free, No ads, Open source, No tracking);
// hovering, focusing, or tapping one opens a simulated dialog over the phone with a fuller explanation.
// Labels and dialog text come from src/i18n/<locale>.json under home.visual.
//
// Four arrangements exist (src/lib/site.ts `designOptions.visuals`). A production build renders only the
// chosen one (`design.visual`); a development build renders all four and shows the one selected in the
// design picker via <html data-visual>.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { design, designOptions } from '../lib/site';
import { useTranslations } from '../i18n';

const { t } = useTranslations(Astro.currentLocale);
const variants = import.meta.env.DEV ? designOptions.visuals.map((v) => v.id) : [design.visual];

const tags = [
  { key: 'free', icon: 'redeem' },
  { key: 'noAds', icon: 'ban' },
  { key: 'openSource', icon: 'code' },
  { key: 'noTracking', icon: 'shield' },
] as const;
const rows = [
  { tone: 'blue', w: 62 }, { tone: 'green', w: 48 }, { tone: 'amber', w: 70 }, { tone: 'purple', w: 55 }, { tone: 'teal', w: 44 },
];
// The "Free" text carries a link in the middle of the sentence; split around the placeholder.
const [freeBefore, freeAfter = ''] = t('home.visual.popups.free.text').split('{freedoms}');
---
{variants.map((variant) => (
  <div class="hv" data-variant={variant} data-hero-visual data-active="">
    {variant === 'emblem' ? (
      <div class="emblem"><div class="emblem-glow"></div><Logo size={128} class="emblem-mark" /><div class="frost" aria-hidden="true"></div></div>
    ) : (
      <div class="phones">
        {(variant === 'duo' ? ['back', 'front'] : ['front']).map((which) => (
          <div class:list={['phone', which]}>
            <div class="phone-top"><Logo size={22} /><span class="bar" style="width: 40%"></span><span class="dot"></span></div>
            <div class="phone-search"><Icon name="search" /><span class="bar" style="width: 55%"></span></div>
            <ul class="apps">
              {rows.map((a) => (
                <li data-tone={a.tone}>
                  <span class="app-icon"></span>
                  <span class="lines"><span class="bar strong" style={`width: ${a.w}%`}></span><span class="bar" style={`width: ${Math.min(90, a.w + 25)}%`}></span></span>
                  <span class="get">GET</span>
                </li>
              ))}
            </ul>
            {which === 'front' && <div class="frost" aria-hidden="true"></div>}
          </div>
        ))}
      </div>
    )}

    <div class="tags">
      {tags.map((tag, i) => (
        <button type="button" class={`tag t${i + 1}`} data-tag={tag.key} aria-expanded="false" aria-controls={`hv-${variant}-${tag.key}`}>
          <Icon name={tag.icon} />{t(`home.visual.${tag.key}`)}
        </button>
      ))}
    </div>

    {tags.map((tag) => (
      <div class="popup" id={`hv-${variant}-${tag.key}`} data-key={tag.key} role="dialog" aria-label={t(`home.visual.${tag.key}`)} hidden>
        <div class="popup-head"><span class="popup-icon"><Icon name={tag.icon} /></span><h4>{t(`home.visual.${tag.key}`)}</h4></div>
        {tag.key === 'free' ? (
          <p>{freeBefore}<a href={t('home.visual.popups.free.url')} rel="noopener">{t('home.visual.popups.free.freedomsLabel')}</a>{freeAfter}</p>
        ) : (
          <p>{t(`home.visual.popups.${tag.key}.text`)}</p>
        )}
        <button type="button" class="popup-ok" data-popup-close>{t('home.visual.ok')}</button>
      </div>
    ))}
  </div>
))}

<script>
  // One dialog open at a time per graphic. Hover and keyboard focus open it, leaving (with a short grace
  // period so the pointer can travel into the dialog and click its link) closes it; a click toggles it,
  // which is what touch screens get; Escape and the OK button close it.
  document.querySelectorAll<HTMLElement>('[data-hero-visual]').forEach((hv) => {
    const tags = Array.from(hv.querySelectorAll<HTMLButtonElement>('[data-tag]'));
    const popups = Array.from(hv.querySelectorAll<HTMLElement>('.popup'));
    let timer = 0;
    let pinned = false; // opened by click/tap: stays until closed explicitly
    const show = (key: string | null) => {
      window.clearTimeout(timer);
      hv.dataset.active = key ?? '';
      popups.forEach((p) => (p.hidden = p.dataset.key !== key));
      tags.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.tag === key)));
    };
    const hide = () => { timer = window.setTimeout(() => { if (!pinned) show(null); }, 180); };
    tags.forEach((b) => {
      b.addEventListener('mouseenter', () => { if (!pinned) show(b.dataset.tag!); });
      b.addEventListener('mouseleave', hide);
      b.addEventListener('focus', () => { if (!pinned) show(b.dataset.tag!); });
      b.addEventListener('blur', hide);
      b.addEventListener('click', () => {
        if (pinned && hv.dataset.active === b.dataset.tag) { pinned = false; show(null); }
        else { pinned = true; show(b.dataset.tag!); }
      });
    });
    popups.forEach((p) => {
      p.addEventListener('mouseenter', () => window.clearTimeout(timer));
      p.addEventListener('mouseleave', hide);
      p.querySelector('[data-popup-close]')?.addEventListener('click', () => { pinned = false; show(null); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { pinned = false; show(null); } });
    document.addEventListener('click', (e) => { if (pinned && !hv.contains(e.target as Node)) { pinned = false; show(null); } });
    // Development aid: `?popup=free` opens a dialog on load so it can be reviewed without a pointer.
    if (import.meta.env.DEV) {
      const want = new URLSearchParams(location.search).get('popup');
      if (want && tags.some((b) => b.dataset.tag === want)) { pinned = true; show(want); }
    }
  });
</script>

<style>
  /* ---- shared pieces ---- */
  .hv { position: relative; width: min(100%, 400px); margin-inline: auto; padding: 16px 0; display: none; }
  :global(:root[data-visual='catalog']) .hv[data-variant='catalog'],
  :global(:root[data-visual='stacked']) .hv[data-variant='stacked'],
  :global(:root[data-visual='duo']) .hv[data-variant='duo'],
  :global(:root[data-visual='emblem']) .hv[data-variant='emblem'] { display: block; }

  .phones { position: relative; width: 270px; margin-inline: auto; }
  .phone {
    position: relative; width: 270px; aspect-ratio: 9 / 18.5;
    border-radius: 38px; padding: 18px 14px;
    background: linear-gradient(160deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    box-shadow: var(--shadow), inset 0 0 0 6px color-mix(in srgb, var(--bg) 70%, var(--border-soft));
    overflow: hidden;
  }
  .phone::before { content: ''; position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 84px; height: 22px; border-radius: 999px; background: var(--bg); }
  .phone-top { display: flex; align-items: center; gap: 10px; margin: 30px 4px 14px; }
  .phone-top :global(img) { border-radius: 6px; }
  .dot { width: 22px; height: 22px; border-radius: 999px; margin-left: auto; background: linear-gradient(135deg, var(--tone-blue), var(--tone-purple)); opacity: 0.8; }
  .phone-search { display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border-radius: 10px; background: var(--hover-strong); margin: 0 2px 14px; color: var(--faint); }
  .phone-search :global(.icon) { width: 14px; height: 14px; }
  .bar { display: block; height: 7px; border-radius: 999px; background: var(--border); }
  .bar.strong { background: var(--faint); height: 8px; }
  .apps { list-style: none; margin: 0; padding: 0 2px; display: flex; flex-direction: column; gap: 10px; }
  .apps li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px; border-radius: 12px; background: color-mix(in srgb, var(--surface) 60%, transparent); border: 1px solid var(--border-soft); }
  .app-icon { width: 40px; height: 40px; border-radius: 11px; background: linear-gradient(145deg, color-mix(in srgb, var(--tone) 85%, white), var(--tone)); box-shadow: inset 0 -6px 12px rgba(0,0,0,0.14); }
  .lines { display: flex; flex-direction: column; gap: 6px; }
  .get { font: 700 0.62rem var(--font); letter-spacing: 0.06em; color: var(--brand); padding: 4px 10px; border-radius: 999px; background: color-mix(in srgb, var(--brand) 14%, transparent); }

  .tag {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 12px; border-radius: 999px; font: 700 0.8rem var(--font);
    background: var(--surface); border: 1px solid var(--border); color: var(--text); box-shadow: var(--shadow);
    cursor: default; white-space: nowrap; position: relative; z-index: 6;
    transition: border-color 0.15s ease, transform 0.15s ease, opacity 0.2s ease;
  }
  /* While a dialog is open every tag steps back, the active one included, so the dialog's text reads
     through whichever of them overlaps it (their widths vary by locale). */
  .hv:not([data-active='']) .tag { opacity: 0.3; }
  .tag:hover, .tag:focus-visible, .tag[aria-expanded='true'] { border-color: var(--accent); transform: translateY(-1px); }
  .tag :global(.icon) { width: 14px; height: 14px; color: var(--accent); }

  /* Frosted overlay on the phone screen (or the emblem) while a dialog is open. */
  .frost {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: color-mix(in srgb, var(--bg) 35%, transparent);
    backdrop-filter: blur(6px) saturate(80%); -webkit-backdrop-filter: blur(6px) saturate(80%);
    opacity: 0; transition: opacity 0.2s ease;
  }
  .phone .frost { border-radius: 32px; }
  .emblem .frost { border-radius: 50%; }
  .hv:not([data-active='']) .frost { opacity: 1; }

  /* The simulated dialog, laid over the phone screen (or the emblem): slides up from the bottom. */
  .popup {
    position: absolute; z-index: 5; width: 232px;
    padding: 16px 16px 12px; border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 92%, var(--text) 4%);
    border: 1px solid var(--border); box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.7), 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    animation: popup-in 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .popup[hidden] { display: none; }
  .popup-head { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  .popup-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); }
  .popup-icon :global(.icon) { width: 15px; height: 15px; }
  .popup h4 { margin: 0; font-size: 0.95rem; font-family: var(--font); letter-spacing: 0; }
  .popup p { margin: 0 0 10px; font-size: 0.78rem; line-height: 1.5; color: var(--muted); }
  .popup p a { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }
  .popup-ok { display: block; width: 100%; padding: 8px; border: 0; border-top: 1px solid var(--border-soft); background: transparent; color: var(--brand); font: 650 0.85rem var(--font); cursor: pointer; }
  @keyframes popup-in { from { opacity: 0; transform: translateY(48px); } to { opacity: 1; transform: translateY(0); } }

  /* ---- catalog: tags pinned around one phone ---- */
  .hv[data-variant='catalog'] .tags .tag { position: absolute; }
  .hv[data-variant='catalog'] .t1 { left: 26px; top: 4.5%; }
  .hv[data-variant='catalog'] .t2 { right: 18px; top: 31%; }
  .hv[data-variant='catalog'] .t3 { left: 20px; bottom: 26%; }
  .hv[data-variant='catalog'] .t4 { right: 22px; bottom: 9%; }
  .hv[data-variant='catalog'] .popup { left: 50%; top: 120px; translate: -50% 0; }

  /* ---- stacked: phone left, a column of tags to its right ---- */
  .hv[data-variant='stacked'] { display: none; }
  :global(:root[data-visual='stacked']) .hv[data-variant='stacked'] { display: flex; align-items: center; gap: 22px; width: min(100%, 440px); }
  .hv[data-variant='stacked'] .phones { margin: 0; flex: none; }
  .hv[data-variant='stacked'] .tags { display: flex; flex-direction: column; gap: 12px; }
  .hv[data-variant='stacked'] .tag { justify-content: flex-start; padding: 10px 14px; border-radius: 14px; }
  .hv[data-variant='stacked'] .popup { left: 19px; top: 120px; }

  /* ---- duo: two phones, tags in a row below ---- */
  .hv[data-variant='duo'] .phones { width: 340px; padding: 0 0 26px; }
  .hv[data-variant='duo'] .phone.back { position: absolute; right: 0; top: -14px; transform: rotate(6deg) scale(0.92); transform-origin: bottom right; opacity: 0.9; filter: saturate(0.9); }
  .hv[data-variant='duo'] .phone.back .apps li { background: color-mix(in srgb, var(--tone-green) 6%, var(--surface)); }
  .hv[data-variant='duo'] .phone.front { z-index: 1; }
  .hv[data-variant='duo'] .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 6px; }
  .hv[data-variant='duo'] .popup { left: 50%; top: 120px; translate: -118px 0; }

  /* ---- emblem: the mark in a glow, tags at four corners ---- */
  .hv[data-variant='emblem'] { min-height: 420px; }
  .emblem { position: relative; width: 300px; height: 300px; margin: 50px auto 0; display: grid; place-items: center; border-radius: 50%; }
  .emblem-glow { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 34%, transparent), color-mix(in srgb, var(--accent-2, var(--brand)) 12%, transparent) 60%, transparent); }
  .emblem-glow::after { content: ''; position: absolute; inset: 46px; border-radius: 50%; border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent); }
  .emblem :global(.emblem-mark) { position: relative; border-radius: 28px; box-shadow: var(--shadow); }
  .hv[data-variant='emblem'] .tags .tag { position: absolute; }
  .hv[data-variant='emblem'] .t1 { left: 18px; top: 60px; }
  .hv[data-variant='emblem'] .t2 { right: 18px; top: 90px; }
  .hv[data-variant='emblem'] .t3 { left: 30px; bottom: 60px; }
  .hv[data-variant='emblem'] .t4 { right: 14px; bottom: 32px; }
  .hv[data-variant='emblem'] .popup { left: 50%; top: 50%; translate: -50% -50%; }

  @media (max-width: 420px) {
    .hv[data-variant='catalog'] .tags, .hv[data-variant='emblem'] .tags { position: static; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 12px; }
    .hv[data-variant='catalog'] .tags .tag, .hv[data-variant='emblem'] .tags .tag { position: static; }
    :global(:root[data-visual='stacked']) .hv[data-variant='stacked'] { flex-direction: column; }
    .hv[data-variant='stacked'] .tags { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .hv[data-variant='stacked'] .popup { left: 50%; translate: -50% 0; }
  }
</style>
