---
import { useTranslations } from '../i18n';
const { t } = useTranslations(Astro.currentLocale);
interface Props {
  code: string;
  label?: string;
  class?: string;
}
const { code, label = t('copy.label'), class: className } = Astro.props;
---
<div class:list={['code-block', className]} data-code-block data-copy-label={label}><pre><code>{code}</code></pre></div>
