---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../lib/site';
import { excerpt, readingTime } from '../../lib/posts';
import { useTranslations, localizePath, formatDate, resolveLocale } from '../../i18n';

const locale = resolveLocale(Astro.currentLocale);
const { t } = useTranslations(locale);
const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={t('blog.title')} description={t('blog.description')} active="blog" ogImage="/og/blog.png">
  <div class="container">
    <header class="page-head blog-head">
      <div>
        <p class="eyebrow">{t('blog.eyebrow')}</p>
        <h1>{t('blog.title')}</h1>
        <p class="lead">{t('blog.description')}</p>
      </div>
      <a class="btn btn-ghost btn-sm" href={site.rss}><Icon name="rss" /> {t('blog.subscribe')}</a>
    </header>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-row" href={localizePath(`/blog/${post.id}/`, locale)}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
            <div>
              <h2>{post.data.title}{post.data.draft && <span class="pill">{t('blog.draft')}</span>}</h2>
              <p>{post.data.description ?? excerpt(post.body ?? '', 240)}</p>
              <div class="post-meta"><span>{t('blog.by', { author: post.data.author })}</span><span>·</span><span>{t('blog.readingTime', { n: readingTime(post.body ?? '') })}</span></div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .post-row h2 .pill { margin-left: 10px; vertical-align: middle; font-size: 0.7rem; }
</style>
